DATABASE_URL=postgresql://versa:versa@localhost:5434/versa

# Real (non-stub) LLM calls read this. Get one at https://aistudio.google.com/apikey
# Every command works without it if you pass --stub (StubLLMClient, no cost, no key needed).
GEMINI_API_KEY=your-key-here

# Optional overrides for the fast/capable/best model tiers (see
# src/versa/model_config.py). Only set these if the defaults there have
# gone stale — Gemini preview model ids shift over time.
# GEMINI_MODEL_FAST=gemini-3.6-flash
# GEMINI_MODEL_CAPABLE=gemini-3.5-flash
# GEMINI_MODEL_BEST=gemini-3.5-flash
# Once a Pro-class model is confirmed available on this key (see
# model_config.py), bump capable/best via these two vars alone —
# no code change needed.
# Model "thinking" effort per tier: default | minimal | low | medium | high | <token budget>.
# Measured: the model's own dynamic thinking costs ~5s before the first word; "minimal" ~1s.
# Defaults: fast/capable = a 256-token budget (keeps the ambiguity check's reference
# resolution correct for ~+0.3s), best = minimal (the streamed answer's first word).
# GEMINI_THINKING_FAST=256
# GEMINI_THINKING_CAPABLE=256
# GEMINI_THINKING_BEST=minimal

# --- Sparks (learning credits, src/versa/sparks.py) ---
# On by default: answers, courses, quizzes and mocks cost Sparks; clarifying
# options are free. Set to off for local development without limits.
# VERSA_SPARKS=off

# --- RevenueCat (subscriptions, Exam Pass, Sparks) ---
# Project id from the dashboard URL (app.revenuecat.com/projects/<id>/...). Not secret.
REVENUECAT_PROJECT_ID=d526484b
# Secret API key "versa-server" (API v2; Customer information: read & write,
# Project configuration: read only). Dashboard -> API keys. Server-side ONLY,
# never in the Flutter app or git.
REVENUECAT_SECRET_KEY=sk_your-key-here
# Long random string; paste the same value into the RevenueCat webhook's
# Authorization header once the server has a public URL.
REVENUECAT_WEBHOOK_AUTH=change-me
# The Flutter app's public SDK key is passed at build time, not read from here:
#   flutter run --dart-define=RC_TEST_KEY=test_...

# --- Sign-in (src/versa/accounts.py) ---
# On unless VERSA_AUTH=off (allowed only with --host 127.0.0.1). A server
# other devices can reach refuses to start without a session secret.
# VERSA_AUTH=off
# Long random string (python -c "import secrets; print(secrets.token_urlsafe(48))").
# Unset on a laptop: a random one per run (sign-ins last until a restart).
# VERSA_SESSION_SECRET=
# VERSA_SESSION_DAYS=30
# The Firebase project whose ID tokens are accepted (Google + email/password).
# Unset: only the testers' name sign-in works.
# FIREBASE_PROJECT_ID=versa-demo
# Name-only sign-in for the team's testers. Default on this machine only:
# sooraj,adithya. A deployed server also needs VERSA_DEV_LOGIN_CODE for it.
# VERSA_DEV_LOGINS=sooraj,adithya
# VERSA_DEV_LOGIN_CODE=
# Invite-only: a NEW account needs a code (`versa invite create`). on|off
# VERSA_INVITES=on
# Where invite links point (`versa invite create` prints links on it).
# VERSA_PUBLIC_URL=https://versa-xxxxxxxx-el.a.run.app
# Where the invite page sends people to get the Android app.
# VERSA_ANDROID_URL=
# Only when a web build is hosted on ANOTHER origin (the phone app needs none).
# VERSA_CORS_ORIGIN_REGEX=

# Answers start the way a learner usually goes into an idea, once their own
# "where this could go" picks make that clear (pick_prediction.py). off = a
# style-off server, for comparing answers with and without it.
# VERSA_ADAPT_ANSWERS=on
